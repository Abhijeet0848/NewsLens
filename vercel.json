{
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/classify.py": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/health.py": {
      "memory": 1024,
      "maxDuration": 30
    }
