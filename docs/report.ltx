\chapter{Introduction}

\section{Background}
Automated news article classification is a well-established task in Natural Language Processing (NLP) and Information Retrieval (IR). As digital news volume grows exponentially, manual categorization has become infeasible. Machine learning models can classify articles into predefined domains with high accuracy, enabling downstream applications such as recommendation systems, media monitoring, and content routing.

\section{Motivation}
Existing classification tools are often black boxes — they produce a label without explaining \textit{why}. This project prioritizes \textbf{transparency}: every intermediate NLP stage is exposed, every model's probability distribution is shown, and every prediction is accompanied by keyword saliency markers.

\section{Scope of the Project}
The system focuses on English-language news classification across five domains derived from the BBC News corpus. It supports:
\begin{itemize}[leftmargin=*]
    \item Real-time single-article classification
    \item Batch CSV processing
    \item Multi-model benchmarking
    \item Explainable predictions via keyword saliency
\end{itemize}

% ============================================================
\chapter{Problem Statement \& Objectives}

\section{Problem Statement}
Design, implement, and rigorously benchmark an automated classification engine that categorizes heterogeneous news texts into five distinct domains:
\begin{itemize}[leftmargin=*]
    \item Business
    \item Entertainment
    \item Politics
    \item Sport
    \item Technology
\end{itemize}

\section{Key Objectives}
\begin{enumerate}[leftmargin=*]
    \item \textbf{Pipeline Transparency:} Expose every intermediate NLP stage, allowing inspection of token transformations, filtered stop-words, and lemmatization changes.
    \item \textbf{Multi-Model Benchmarking:} Train and evaluate multiple supervised algorithms on identical features, tested on identical held-out data.
    \item \textbf{Zero Data Leakage:} Ensure the vectorizer vocabulary and IDF weights are learned strictly from the training set.
    \item \textbf{Interactive Dashboard:} Provide real-time classification, probability distribution analysis, confusion matrix heatmaps, and dataset exploration.
    \item \textbf{Explainability:} Surface keyword saliency and per-class confidence so predictions are transparent.
\end{enumerate}

