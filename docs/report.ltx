\chapter{Mathematical Foundations}

\section{TF-IDF Vectorization}

The Term Frequency--Inverse Document Frequency weight for term $t$ in document $d$ within corpus $D$ is:

\begin{equation}
\text{TF}(t, d) = \frac{f_{t,d}}{\sum_{t' \in d} f_{t',d}}
\end{equation}

\begin{equation}
\text{IDF}(t, D) = \ln\left(\frac{1 + |D|}{1 + |\{d \in D : t \in d\}|}\right) + 1
\end{equation}

\begin{equation}
\text{TF-IDF}(t, d, D) = \text{TF}(t, d) \times \text{IDF}(t, D)
\end{equation}

Followed by $L_2$ normalization:

\begin{equation}
\hat{\mathbf{v}} = \frac{\mathbf{v}}{\|\mathbf{v}\|_2}
\end{equation}

\section{Multinomial Naive Bayes}

Posterior probability with Laplace smoothing ($\alpha = 0.1$):

\begin{equation}
P(c_k \mid \mathbf{x}) \propto P(c_k) \prod_{i=1}^{n} P(x_i \mid c_k)^{f_i}
\end{equation}

\begin{equation}
\theta_{ki} = \frac{\sum_{d \in c_k} x_{di} + \alpha}{\sum_{j} \sum_{d \in c_k} x_{dj} + \alpha |V|}
\end{equation}

\section{Linear Support Vector Machine}

Primal quadratic programming formulation:

\begin{equation}
\min_{\mathbf{w}, b, \boldsymbol{\xi}} \frac{1}{2}\|\mathbf{w}\|^2 + C \sum_{i=1}^N \xi_i
\end{equation}

subject to:
\begin{equation}
y_i(\mathbf{w}^\top \mathbf{x}_i + b) \ge 1 - \xi_i, \quad \xi_i \ge 0
\end{equation}

\section{Multi-Layer Perceptron}

Feedforward network with ReLU activations and softmax output:

\begin{equation}
\mathbf{h}^{(1)} = \text{ReLU}(\mathbf{W}^{(1)}\mathbf{x} + \mathbf{b}^{(1)})
\end{equation}

\begin{equation}
\mathbf{h}^{(2)} = \text{ReLU}(\mathbf{W}^{(2)}\mathbf{h}^{(1)} + \mathbf{b}^{(2)})
\end{equation}

\begin{equation}
\hat{y}_k = \frac{\exp(z_k)}{\sum_{j=1}^K \exp(z_j)}
\end{equation}

Cross-entropy loss:

\begin{equation}
\mathcal{L} = -\sum_{k=1}^K y_k \ln(\hat{y}_k)
\end{equation}

\section{DistilBERT Fine-Tuning}

DistilBERT \cite{sanh2019} is a distilled version of BERT — 40\% smaller, 60\% faster, retaining $\sim$97\% of BERT's performance. Fine-tuning minimizes cross-entropy over the classification head:

\begin{equation}
\mathcal{L}_{\text{CLS}} = -\frac{1}{N} \sum_{i=1}^{N} \log P(y_i \mid \text{CLS}(\mathbf{h}_i))
\end{equation}

where $\text{CLS}(\mathbf{h}_i)$ is the final \texttt{[CLS]} token representation from the last transformer layer.

